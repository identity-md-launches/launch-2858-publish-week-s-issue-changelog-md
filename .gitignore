!/artifacts/003-screenshots/desktop.png
!/artifacts/003-screenshots/glossary.png
!/artifacts/003-screenshots/keyboard-focus.png
!/artifacts/004-counts.json
!/artifacts/004-story-evidence.json
!/artifacts/004-interaction-results.json
!/artifacts/004-render-review.json
!/artifacts/004-taste.json
!/artifacts/004-screenshots/
/artifacts/004-screenshots/*
!/artifacts/004-screenshots/mobile-first-screen.jpg
!/artifacts/004-screenshots/desktop.jpg
!/artifacts/004-screenshots/glossary.jpg
!/artifacts/004-screenshots/keyboard-focus.jpg
!/artifacts/005-counts.json
